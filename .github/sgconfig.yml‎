# ast-grep project config for CI:
#   ast-grep scan --config .github/sgconfig.yml \
#     scripts/setup.sh hooks.py plugin.yaml \
#     extensions/python/tool_execute_before/_10_rtk_intercept.py
# Scope note: invoke on PRODUCTION paths (or set ignores for
# tests/docs/.github) - the pin rule intentionally flags vX.Y.Z literals
# that legitimately appear in test fixtures/docs, so a repo-wide scan
# without ignores self-flags those by design.
ruleDirs:
  - "ast-rules"